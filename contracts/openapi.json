      "EventIn": {
        "additionalProperties": false,
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "event": {
            "discriminator": {
              "mapping": {
                "COMMITMENT_CHANGED": "#/components/schemas/CommitmentChanged",
                "DELIVERY_CANCELLED": "#/components/schemas/DeliveryCancelled",
                "DELIVERY_DELAYED": "#/components/schemas/DeliveryDelayed",
                "DONATION_CANCELLED": "#/components/schemas/DonationCancelled",
                "DONATION_CREATED": "#/components/schemas/DonationCreated",
                "INGREDIENT_EXPIRED": "#/components/schemas/IngredientExpired",
                "INVENTORY_ADJUSTED": "#/components/schemas/InventoryAdjusted",
                "PREPARATION_CAPACITY_CHANGED": "#/components/schemas/PreparationCapacityChanged",
                "VOLUNTEER_UNAVAILABLE": "#/components/schemas/VolunteerUnavailable"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/DonationCreated"
              },
              {
                "$ref": "#/components/schemas/DonationCancelled"
              },
              {
                "$ref": "#/components/schemas/InventoryAdjusted"
              },
              {
                "$ref": "#/components/schemas/IngredientExpired"
              },
              {
                "$ref": "#/components/schemas/VolunteerUnavailable"
              },
              {
                "$ref": "#/components/schemas/DeliveryDelayed"
              },
              {
                "$ref": "#/components/schemas/DeliveryCancelled"
              },
              {
                "$ref": "#/components/schemas/CommitmentChanged"
              },
              {
                "$ref": "#/components/schemas/PreparationCapacityChanged"
              }
            ],
            "title": "Event"
          },
          "idempotency_key": {
            "maxLength": 200,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "idempotency_key",
          "event"
        ],
        "title": "EventIn",
        "type": "object"
      },
